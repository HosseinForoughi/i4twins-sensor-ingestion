{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "SensorIngestion": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SensorIngestion": "Data Source=sensor-ingestion.db"
  },
  "Rules": {
    "SeedFilePath": "Data/rules.json"
  },
  "Readings": {
    "FilePath": "Data/readings.jsonl"
  },
  "Processing": {
    "BatchSize": 500
  },
  "Alerting": {
    "CooldownMinutes": 5
  }
}